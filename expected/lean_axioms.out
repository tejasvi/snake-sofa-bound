main_ge : ∀ (M : ℝ), 2 + √2 ≤ M → Vstar M ≤ ENNReal.ofReal (2 * √2)
@chord_sq_le_one : ∀ {d₁ d₂ e₁ e₂ : ℝ},
  d₁ ^ 2 + d₂ ^ 2 = 1 → e₁ ^ 2 + e₂ ^ 2 = 1 → d₁ * e₁ + d₂ * e₂ = 0 → ∫⁻ (g : ℝ), chord d₁ d₂ e₁ e₂ g ^ 2 ≤ 1
@tilt : ∀ {u : ℝ},
  √2 < u →
    ∀ {ρ w f₁ f₂ p q : Fin 3 → ℝ},
      Orthonormal3 w f₁ f₂ →
        p ∈ tube ρ w f₁ f₂ → q ∈ tube ρ w f₁ f₂ → p ∈ W 1 → q ∈ W (1 + u) → (u ^ 2 - 2) / (u ^ 2 + 2) ≤ |w 1|
@prop45 : ∀ {M u s : ℝ},
  √2 < u →
    u < M →
      0 < s →
        s ≤ muStar u →
          ∀ {B : Set (Fin 3 → ℝ)},
            IsBody B →
              ∀ {g : ↑unitInterval → Matrix (Fin 3) (Fin 3) ℝ × (Fin 3 → ℝ)},
                IsWeakPassage M B g → MeasureTheory.volume B ≤ ENNReal.ofReal (1 / s + 1 / √(1 - s ^ 2))
one_le_Vstar : ∀ (M : ℝ), 0 ≤ M → 1 ≤ Vstar M
